{
  "name": "agent-engineering",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Agent Engineering: building AI agents from scratch in Python — course materials",
  "author": "Nicholas Johnson",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "slides:01": "pnpm --filter @agent-engineering/module-01-slides dev",
    "slides:02": "pnpm --filter @agent-engineering/module-02-slides dev",
    "slides:03": "pnpm --filter @agent-engineering/module-03-slides dev",
    "slides:04": "pnpm --filter @agent-engineering/module-04-slides dev",
    "slides:05": "pnpm --filter @agent-engineering/module-05-slides dev",
    "slides:06": "pnpm --filter @agent-engineering/module-06-slides dev",
    "slides:07": "pnpm --filter @agent-engineering/module-07-slides dev",
    "slides:08": "pnpm --filter @agent-engineering/module-08-slides dev",
    "slides:day-one-closing": "pnpm --filter @agent-engineering/day-one-closing-slides dev",
    "slides:day-two-recap": "pnpm --filter @agent-engineering/day-two-recap-slides dev",
    "slides:day-two-closing": "pnpm --filter @agent-engineering/day-two-closing-slides dev",
    "slides:pdf": "node scripts/export-slides-pdf.mjs",
    "social": "pnpm --filter @agent-engineering/social-scripts dev",
    "social:new": "pnpm --filter @agent-engineering/social-scripts new",
    "social:check": "pnpm --filter @agent-engineering/social-scripts check",
    "lint:slides": "eslint slide-deck/",
    "format:slides": "prettier --write slide-deck/ \"day-*/module-*/slides/src/**\" \"day-*/closing/slides/src/**\" \"day-*/recap/slides/src/**\"",
    "test": "uv run pytest"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10"
  }
}
